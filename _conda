__conda_describe_package_version(){
    local current_package="$1"
    # conda search output is large and shell parsing is comparatively slow,
    # so cache each package's version list like the package list.
    local cache_name
    local -a versions
    __conda_set_cache_policy
    cache_name="conda_versions_${current_package//[^A-Za-z0-9_.-]/_}"
    if _cache_invalid "$cache_name" || ! _retrieve_cache "$cache_name"; then
        versions=($(
            conda search --json --use-index-cache \
                "$current_package" 2>/dev/null |
            __conda_json_package_versions "$current_package" 2>/dev/null))
        if (( ${#versions} )); then
            _store_cache "$cache_name" versions
        fi
    fi
    _describe -t versions "$current_package version" versions
}

# Revision numbers for --revision, taken from conda list --revisions.  The
# plain-text output is used because the JSON form is an array that the
# embedded query would need another mode to read.
__conda_revisions(){
    local -a args revisions
    local i
    for (( i = 1; i <= ${#words}; i++ )); do
        case ${words[i]} in
        (-n|--name|-p|--prefix)
            if (( i < ${#words} )) && [[ -n ${words[i+1]} ]]; then
                args+=("${words[i]}" "${words[i+1]}")
            fi
            ;;
        (--name=*|--prefix=*)
            args+=("${words[i]}")
            ;;
        esac
    done
    revisions=($(conda list --revisions "${args[@]}" 2>/dev/null |
        sed -n 's/^.*(rev \([0-9][0-9]*\)).*$/\1/p'))
    (( ${#revisions} )) && print -l -r -- "${revisions[@]}"
    return 0
}

__conda_describe_revisions(){
    local -a revisions
    revisions=($( __conda_revisions ))
    if (( ${#revisions} )); then
        _describe -t revisions 'revision' revisions
    else
        _message "no revisions found"
    fi
}

# Environment variables configured in the target environment (or the active
# one).  The JSON form is a plain object, so the root object keys are enough.
__conda_env_config_vars(){
    local -a args env_vars
    local i
    for (( i = 1; i <= ${#words}; i++ )); do
        case ${words[i]} in
        (-n|--name|-p|--prefix)
            if (( i < ${#words} )) && [[ -n ${words[i+1]} ]]; then
                args+=("${words[i]}" "${words[i+1]}")
            fi
            ;;
        (--name=*|--prefix=*)
            args+=("${words[i]}")
            ;;
        esac
    done
    env_vars=($(conda env config vars list --json "${args[@]}" 2>/dev/null |
        __conda_json_object_keys 2>/dev/null))
    if __conda_is_error_json "${env_vars[@]}"; then
        env_vars=()
    fi
    (( ${#env_vars} )) && print -l -r -- "${env_vars[@]}"
    return 0
}

__conda_describe_env_config_vars(){
    local -a env_vars
    env_vars=($( __conda_env_config_vars ))
    if (( ${#env_vars} )); then
        _describe -t env_config_vars 'environment variable' env_vars
    else
        _message "no environment variables found"
    fi
}

__conda_env_config_var_value(){
    local name="$1"
    local -a args values
    local i
    [[ $name == ([A-Za-z_][A-Za-z0-9_]*) ]] || return 0
    for (( i = 1; i <= ${#words}; i++ )); do
        case ${words[i]} in
        (-n|--name|-p|--prefix)
            if (( i < ${#words} )) && [[ -n ${words[i+1]} ]]; then
                args+=("${words[i]}" "${words[i+1]}")
            fi
            ;;
        (--name=*|--prefix=*)
            args+=("${words[i]}")
            ;;
        esac
    done
    values=("${(@f)$(conda env config vars list "${args[@]}" 2>/dev/null |
        sed -n "s/^${name} = //p")}")
    values=("${(@)values:#}")
    (( ${#values} )) && print -l -r -- "${values[@]}"
    return 0
}

__conda_describe_env_config_var_value(){
    local name="$1"
    local -a values
    values=("${(@f)$( __conda_env_config_var_value "$name" )}")
    values=("${(@)values:#}")
    if (( ${#values} )); then
        _wanted env_config_values expl 'environment variable value' \
            compadd -a values
    fi
}

__conda_describe_env_config_var_assignments(){
    local -a env_vars
    if compset -P '*='; then
        __conda_describe_env_config_var_value "${IPREFIX[1,-2]}"
        return 0
    fi
    env_vars=($( __conda_env_config_vars ))
    if (( ${#env_vars} )); then
        _describe -t env_config_vars 'environment variable' env_vars -S '='
    else
        _message "no environment variables found"
    fi
}

__conda_commands(){
    local -a package maint environment config special external
    package=(
        search:'search for packages and display associated information'
        install:'install a list of packages into a specified conda environment'
        repoquery:'search repodata for package dependencies'
    )
    maint=(
        update:'update conda packages to the latest compatible version'
        upgrade:'alias for update'
        clean:'remove unused packages and caches'
        index:'update package index metadata files'
    )
    environment=(
        info:'display information about current conda install'
        create:'create a new conda environment from specified packages'
        list:'list installed packages in a conda environment'
        remove:'remove a list of packages from a specified conda environment'
        uninstall:'alias for remove'
        rename:'rename an existing environment'
        export:'export a given environment'
        compare:'compare packages between conda environments'
        doctor:'display a health report for your environment'
        activate:'activate a conda environment'
        deactivate:'deactivate the current active conda environment'
        pack:'package an existing environment into an archive'
        develop:'install a python package in development mode'
    )
    config=(
        config:'modify configuration values in .condarc'
        content-trust:'sign and verify conda metadata'
        token:'configure token access for anaconda commercial edition'
    )
    special=(
        run:'run an executable in a conda environment'
        init:'initialize conda for shell interaction'
        package:'create low-level conda packages (EXPERIMENTAL)'
        commands:'list all available conda subcommands'
        notices:'retrieve latest channel notifications'
        convert:'convert pure python packages to other platforms'
        debug:'set up environments to debug a build or test phase'
        inspect:'inspect conda packages'
        metapackage:'create a conda metapackage'
        render:'expand a recipe into a platform-specific recipe'
        skeleton:'generate a boilerplate conda recipe'
        root:'run the top-level conda command'
    )
    external=(
        env:'manage environments'
        build:'build conda packages from a conda recipe'
        repo:'manage an anaconda repository'
        server:'manage an anaconda repository server'
        )

    # This takes care of alignment if the user wanted the subcommand completion
    # to be split into groups.
    if zstyle -t ":conda_zsh_completion:*" use-groups; then
        _describe -t package_commands "package command" package
        _describe -t maint_commands "maint command" maint
        _describe -t environment_commands "environment command" environment
        _describe -t config_commands "config command" config
        _describe -t special_commands "special command" special
        _describe -t external_commands "external command" external
    else
        _describe "conda command" package -- maint -- environment \
            -- config -- special -- external
    fi
}

