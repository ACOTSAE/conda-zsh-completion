    (skeleton)
        _arguments -C $help_opts \
                      ': :->command' \
                      '*:: :->subcmd'
        case $state in
        (command)
            local -a skeleton_commands
            skeleton_commands=(
                cpan:'generate a recipe for a cpan package'
                cran:'generate a recipe for a cran package'
                luarocks:'generate a recipe for a luarocks package'
                pypi:'generate a recipe for a pypi package'
                rpm:'generate a recipe for an rpm package'
            )
            _describe -t skeleton_commands "skeleton command" skeleton_commands
            ;;
        (subcmd)
            case ${line[1]} in
                (cpan|cran|luarocks|pypi|rpm)
                    _arguments -C $help_opts \
                                  $skeleton_opts \
                                  '*:package:'
                    ;;
            esac
            ;;
        esac
        ;;
    (token)
        _arguments -C $help_opts \
                      '(-V --version)'{-V,--version}'[show the conda-token version number and exit]' \
                      ': :->command' \
                      '*:: :->subcmd'
        case $state in
        (command)
            local -a token_commands
            token_commands=(
                list:'list the configured token'
                remove:'remove the token and revert default_channels'
                set:'set the token and configure default_channels'
            )
            _describe -t token_commands "token command" token_commands
            ;;
        (subcmd)
            case ${line[1]} in
                (list)
                    _arguments -C $help_opts
                    ;;
                (remove)
                    _arguments -C $help_opts \
                                  '(--env --file)--system[write to the system .condarc file]' \
                                  '(--system --file)--env[write to the active environment .condarc file]' \
                                  '(--system --env)--file[write to the given file]:config file:_path_files'
                    ;;
                (set)
                    _arguments -C $help_opts \
                                  '--include-archive-channels[add archived channels to default_channels]:channel:(mro mro-archive free pro)' \
                                  '--no-ssl-verify[disable ssl verification]' \
                                  '--enable-signature-verification[enable package signature verification]' \
                                  '(--env --file)--system[write to the system .condarc file]' \
                                  '(--system --file)--env[write to the active environment .condarc file]' \
                                  '(--system --env)--file[write to the given file]:config file:_path_files' \
                                  ':token:'
                    ;;
            esac
            ;;
        esac
        ;;
    (activate)
        _arguments -C $help_opts \
                      '(--no-stack)--stack[stack the environment on top of the previous environment]' \
                      '(--stack)--no-stack[do not stack the environment; override auto_stack]' \
                      '*:environment:{__conda_envs; _directories}'
        ;;
    (deactivate)
        _arguments -C $help_opts \
        ;;
    esac
    ;;
esac
