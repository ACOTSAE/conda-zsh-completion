# All keys known to the current conda, including context parameters that
# --show and --describe accept but that are not part of the user schema.
__conda_all_config_keys(){
    local -a config_keys
    config_keys=($(conda config --show --json 2>/dev/null |
        __conda_json_object_keys 2>/dev/null))
    if __conda_is_error_json "${config_keys[@]}"; then
        config_keys=()
    fi
    if (( ! ${#config_keys} )); then
        config_keys=("${__conda_config_keys[@]}")
    fi
    (( ${#config_keys} )) && print -l -r -- "${config_keys[@]}"
    return 0
}

# --set only accepts primitive keys; list and map keys use --append/--prepend.
__conda_settable_config_keys(){
    local -a config_keys settable_keys
    local k
    config_keys=($( __conda_all_config_keys ))
    settable_keys=()
    for k in "${config_keys[@]}"; do
        if (( ! ${__conda_list_config_keys[(I)$k]} )) &&
            (( ! ${__conda_map_config_keys[(I)$k]} )); then
            settable_keys+=("$k")
        fi
    done
    (( ${#settable_keys} )) && print -l -r -- "${settable_keys[@]}"
    return 0
}

__conda_describe_all_config_keys(){
    local -a config_keys
    config_keys=($( __conda_all_config_keys ))
    if (( ${#config_keys} )); then
        _describe -t config_keys 'configuration key' config_keys
    else
        _message "no configuration keys found"
    fi
}

__conda_describe_settable_config_keys(){
    local -a config_keys
    config_keys=($( __conda_settable_config_keys ))
    if (( ${#config_keys} )); then
        _describe -t config_keys 'configuration key' config_keys
    else
        _message "no configuration keys found"
    fi
}

__conda_current_config_value(){
    conda config --show "$1" 2>/dev/null |
        sed -n "s/^$1: //p" | head -n 1
}

__conda_describe_config_set_values(){
    local key="$1"
    local value=''
    local -a config_values
    if (( ${__conda_boolean_config_keys[(I)$key]} )); then
        __conda_describe_boolean_config_values
        return 0
    fi
    case $key in
    (channel_priority)
        config_values=(strict flexible disabled)
        ;;
    (path_conflict)
        config_values=(clobber warn prevent)
        ;;
    (safety_checks)
        config_values=(enabled warn disabled)
        ;;
    (solver)
        config_values=(classic libmamba)
        ;;
    esac
    if (( ! ${#config_values} )); then
        value=$( __conda_current_config_value "$key" )
        if [[ $value == (True|False) ]]; then
            __conda_describe_boolean_config_values
            return 0
        fi
        [[ -n $value ]] && config_values=("$value")
    fi
    if (( ${#config_values} )); then
        _wanted config_values expl 'configuration value' \
            compadd -a config_values
    else
        _message "no predefined values for '$key'"
    fi
}

