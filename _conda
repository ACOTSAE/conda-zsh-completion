# ---------------------------------------------------------------------------
# Embedded JSON parser
#
# The awk program below is a trimmed, query-aware adaptation of JSON.awk
# (https://github.com/step-/JSON.awk), Copyright (c) 2013 step-, available
# under the MIT licence (see LICENSE.JSON.awk.txt).  JSON.awk prints every
# path/value pair; this completion only needs four small queries, so the output
# side of the parser is reduced to those queries.  The tokenizer, recursive
# descent parser and strict value validation are adapted from JSON.awk.
#
# __conda_json_query MODE [QUERY] reads JSON from stdin and prints:
#
#   object-keys        keys of the root object (conda search package names)
#   config-keys        keys of the "get" object (conda config keys)
#   config-values K    values in the get[K] array (config list values)
#   package-versions P unique "version" values in the P array
#
# Results are buffered until the whole document has parsed successfully,
# matching json.load(): invalid JSON produces no partial output.
# ---------------------------------------------------------------------------

__conda_json_query() {
    emulate -L zsh
    local mode=$1 query=$2
    LC_ALL=C command awk -v MODE="$mode" -v QUERY="$query" '
    BEGIN {
        RS = "\001"
        DEPTH = 0
        NKEY = NVAL = NVER = 0
        FAILED = 0
        PARSED = 0
        if (MODE == "") MODE = "object-keys"
    }

    {
        tokenize($0)
        if (parse() != 0) {
            FAILED = 1
        } else {
            PARSED = 1
        }
    }

    END {
        if (FAILED || !PARSED) {
            if (!PARSED && !FAILED) {
                print "EXPECTED value GOT EOF" > "/dev/stderr"
            }
            exit 1
        }
        if (MODE == "object-keys" || MODE == "config-keys") {
            for (i = 1; i <= NKEY; i++) print KEYS[i]
        } else if (MODE == "config-values") {
            for (i = 1; i <= NVAL; i++) print VALUES[i]
        } else if (MODE == "package-versions") {
            for (i = 1; i <= NVER; i++) print VERSIONS[i]
        }
    }

    function tokenize(a1) {
        gsub(/^\357\273\277|"[^"\\\000-\037]*\
((\\[^u\000-\037]|\\u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])\
[^"\\\000-\037]*)*"\
|-?(0|[1-9][0-9]*)([.][0-9]+)?([eE][+-]?[0-9]+)?\
|null|false|true|[ \t\n\r]+|./, "\n&", a1)
        gsub("\n[ \t\n\r]+", "\n", a1)
        gsub(/^\n(\357\273\277\n)?|\n$/, "", a1)
        ITOKENS = 0
        NTOKENS = split(a1, TOKENS, /\n/)
        return NTOKENS
    }

    function get_token() {
        TOKEN = TOKENS[++ITOKENS]
        return ITOKENS <= NTOKENS
    }

    function report(expected, got) {
        msg = "EXPECTED " expected " GOT " (got == "" ? "EOF" : got)
        print msg > "/dev/stderr"
        FAILED = 1
    }

    function parse(   ret) {
        if (!get_token()) {
            report("value", "")
            return 8
        }
        if (TOKEN == "{") {
            ret = parse_object()
        } else if (TOKEN == "[") {
            ret = parse_array()
        } else if (TOKEN == "") {
            report("value", "")
            return 8
        } else if (is_value(TOKEN) > 0) {
            VALUE = TOKEN
            ret = 0
        } else {
            report("value", TOKEN)
            ret = 9
        }
        if (ret != 0) return ret
        if (get_token()) {
            report("EOF", TOKEN)
            return 10
        }
        return 0
    }

    function parse_value(component,   ret) {
        PATH[++DEPTH] = component
        if (TOKEN == "{") {
            ret = parse_object()
        } else if (TOKEN == "[") {
            ret = parse_array()
        } else if (TOKEN == "") {
            report("value", "")
            ret = 8
        } else if (is_value(TOKEN) > 0) {
            VALUE = TOKEN
            ret = 0
        } else {
            report("value", TOKEN)
            ret = 9
        }
        DEPTH--
        return ret
    }

    function parse_array(   idx, ret) {
        idx = 0
        get_token()
        if (TOKEN != "]") {
            while (1) {
                if ((ret = parse_value(idx)) != 0) return ret
                if (MODE == "config-values" && is_config_values_array()) {
                    if (VALUE != "") {
                        VALUES[++NVAL] = format_value(VALUE)
                    }
                }
                idx++
                get_token()
                if (TOKEN == "]") {
                    break
                } else if (TOKEN == ",") {
                    ;
                } else {
                    report(", or ]", TOKEN)
                    return 2
                }
                get_token()
            }
        }
        VALUE = ""
        return 0
    }

    function parse_object(   key, ret) {
        get_token()
        if (TOKEN != "}") {
            while (1) {
                if (TOKEN ~ /^".*"$/) {
                    key = decode(TOKEN)
                } else {
                    report("string", TOKEN)
                    return 3
                }
                select_key(key)
                get_token()
                if (TOKEN != ":") {
                    report(":", TOKEN)
                    return 4
                }
                get_token()
                if ((ret = parse_value(key)) != 0) return 5
                if (MODE == "package-versions" && DEPTH == 2 &&
                    PATH[1] == QUERY && PATH[2] ~ /^[0-9]+$/ &&
                    key == "version" && VALUE != "") {
                    add_version(VALUE)
                }
                get_token()
                if (TOKEN == "}") {
                    break
                } else if (TOKEN == ",") {
                    ;
                } else {
                    report(", or }", TOKEN)
                    return 6
                }
                get_token()
            }
        }
        VALUE = ""
        return 0
    }

    function select_key(key) {
        if (MODE == "object-keys" && DEPTH == 0) {
            add_key(key)
        } else if (MODE == "config-keys" && DEPTH == 1 && PATH[1] == "get") {
            add_key(key)
        }
    }

    function is_config_values_array() {
        return MODE == "config-values" && DEPTH == 2 &&
               PATH[1] == "get" && PATH[2] == QUERY
    }

    function add_key(key) {
        if (!(key in SEEN_KEY)) {
            SEEN_KEY[key] = 1
            KEYS[++NKEY] = key
        }
    }

    function add_version(raw) {
        v = format_value(raw)
        if (!(v in SEEN_VER)) {
            SEEN_VER[v] = 1
            VERSIONS[++NVER] = v
        }
    }

    function format_value(raw) {
        if (substr(raw, 1, 1) == "\"") return decode(raw)
        if (raw == "true") return "True"
        if (raw == "false") return "False"
        if (raw == "null") return "None"
        return raw
    }

    function is_value(a1) {
        if (a1 ~ /^(true|false|null)$/) return 1
        if (a1 ~ /^-?(0|[1-9][0-9]*)([.][0-9]+)?([eE][+-]?[0-9]+)?$/) return 1
        if (a1 ~ /^"([^"\\\000-\037]|\
\\(["\\\/bfnrt]|\
u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]))*"$/) return 1
        return 0
    }

    function decode(raw,   s, out, i, esc, hex, code, lo) {
        if (substr(raw, 1, 1) != "\"") return raw
        s = substr(raw, 2, length(raw) - 2)
        out = ""
        while ((i = index(s, "\\")) > 0) {
            out = out substr(s, 1, i - 1)
            esc = substr(s, i + 1, 1)
            s = substr(s, i + 2)
            if (esc == "u") {
                hex = substr(s, 1, 4)
                s = substr(s, 5)
                code = hex2num(hex)
                if (code >= 55296 && code <= 56319 &&
                    substr(s, 1, 2) == "\\u") {
                    hex = substr(s, 3, 4)
                    lo = hex2num(hex)
                    if (lo >= 56320 && lo <= 57343) {
                        code = 65536 + (code - 55296) * 1024 + (lo - 56320)
                        s = substr(s, 7)
                    }
                }
                out = out utf8(code)
            } else if (esc == "n") {
                out = out "\n"
            } else if (esc == "t") {
                out = out "\t"
            } else if (esc == "r") {
                out = out "\r"
            } else if (esc == "b") {
                out = out "\b"
            } else if (esc == "f") {
                out = out "\f"
            } else if (esc == "\"" || esc == "\\" || esc == "/") {
                out = out esc
            } else {
                out = out esc
            }
        }
        return out s
    }

    function hex2num(h,   i, c, n, v) {
        n = 0
        h = tolower(h)
        for (i = 1; i <= length(h); i++) {
            c = substr(h, i, 1)
            v = index("0123456789abcdef", c) - 1
            if (v < 0) return 0
            n = n * 16 + v
        }
        return n
    }

    function utf8(code) {
        if (code < 128) return sprintf("%c", code)
        if (code < 2048) {
            return sprintf("%c%c", 192 + int(code / 64), 128 + code % 64)
        }
        if (code < 65536) {
            return sprintf("%c%c%c", 224 + int(code / 4096),
                           128 + int(code / 64) % 64, 128 + code % 64)
        }
        return sprintf("%c%c%c%c", 240 + int(code / 262144),
                       128 + int(code / 4096) % 64, 128 + int(code / 64) % 64,
                       128 + code % 64)
    }
'
}

# Query entry points used by the completion functions below.
__conda_json_object_keys() { __conda_json_query object-keys ; }
__conda_json_config_keys() { __conda_json_query config-keys ; }
__conda_json_config_values() { __conda_json_query config-values "$1" ; }
__conda_json_package_versions() { __conda_json_query package-versions "$1" ; }

__conda_envs(){
    local -a envs localenvs globalenvs
    local conda_path
    local -a ls_opts
    local -a describe_opts
    local unnamed=0 sort=0 globalfirst=0
    local localenvspath
    # only parse environments.txt (including unnamed envs) if asked by the user
    zstyle -t ":conda_zsh_completion:*" show-unnamed && unnamed=1
    zstyle -t ":conda_zsh_completion:*" sort-envs-by-time && sort=1
    zstyle -t ":conda_zsh_completion:*" show-global-envs-first && globalfirst=1

    ls_opts=("-1")
    if (( sort )); then
        ls_opts+=("-t")
        describe_opts+=("-V")
    fi

    conda_exec=$(which conda)

    # Detect homebrew installations and set path accordingly.
    if [[ ${${conda_exec}#*"homebrew"} != ${conda_exec} ]]; then
        conda_path="/opt/homebrew/Caskroom/miniconda/base/envs"
    else
        conda_path="${${CONDA_EXE}%bin/conda}/envs"
    fi

    # global envs (if exists) and base env.
    globalenvs=($([[ -d "$conda_path" ]] &&
        ls "${ls_opts[@]}" "$conda_path"))
    globalenvs+=("base")

    # local envs (if exists).
    if [[ -n "$CONDA_ENVS_PATH" ]]; then
        localenvspath="$CONDA_ENVS_PATH"
    elif [[ -n "$CONDA_ENVS_DIRS" ]]; then
        localenvspath="$CONDA_ENVS_DIRS"
    else
        localenvspath="${HOME:?}/.conda/envs"
    fi
    localenvs=($([[ -d "$localenvspath" ]] &&
        ls "${ls_opts[@]}" "$localenvspath"))

    if (( globalfirst )); then
        envs=("${globalenvs[@]}" "${localenvs[@]}")
    else
        envs=("${localenvs[@]}" "${globalenvs[@]}")
    fi

    # unnamed envs (if show-unnamed).
    if (( unnamed )); then
        envs+=($( (cat "${HOME:?}/.conda/environments.txt") 2>/dev/null |
            cut -f1 -d' ' |
            sed -e "s|^${PWD}|.|" -e "s|^$localenvspath/||"))
    fi

    _describe "${describe_opts[@]}" -t envs 'conda environment' envs
}

__conda_packages_installed(){
    local -a installed_packages conda_list_args
    local option='' environment='' additional_message=''
    # check for command line overrides
    [[ -n "$1" ]] && option="$1"
    [[ -n "$2" ]] && environment="$2"
    conda_list_args=(conda list --no-pip)
    [[ -n $option ]] && conda_list_args+=("$option")
    [[ -n $environment ]] && conda_list_args+=("$environment")
    installed_packages=($("${conda_list_args[@]}" 2>/dev/null |
        sed 1,2d | cut -f1 -d' '))
    [[ -n $option ]] && [[ -n $environment ]] &&
        additional_message=" in environment: '$environment'"
    _describe -t installed_packages \
        "installed package$additional_message" installed_packages
}

# Install the 12-hour default cache policy unless the user configured one.
__conda_is_error_json() {
    local -a keys
    keys=("$@")
    (( ${keys[(I)error]} )) || return 1
    (( ${keys[(I)exception_name]} )) ||
        (( ${keys[(I)exception_type]} ))
}

__conda_set_cache_policy() {
    local cache_policy=''
    if ! zstyle -s ":completion:${curcontext}:" cache-policy cache_policy ||
        [[ -z $cache_policy ]]; then
        zstyle ":completion:${curcontext}:" cache-policy \
            __conda_caching_policy
    fi
}

__conda_package_available(){
    local -a available_packages
    __conda_set_cache_policy
    if _cache_invalid conda_available_packages ||
        ! _retrieve_cache conda_available_packages; then
        available_packages=($(
            conda search --use-index-cache --json 2>/dev/null |
            __conda_json_object_keys 2>/dev/null))
        if (( ${#available_packages} )) &&
            ! __conda_is_error_json "${available_packages[@]}"; then
            _store_cache conda_available_packages available_packages
        fi
    fi
    if __conda_is_error_json "${available_packages[@]}"; then
        available_packages=()
    fi
    if (( ${#available_packages} )); then
        print -l -r -- "${available_packages[@]}"
    fi
    return 0
}

__describe_conda_package_available(){
    local -a available_packages
    available_packages=($( __conda_package_available))
    _describe -t available_packages 'available package' available_packages
}

__conda_existing_config_keys(){
    local -a config_keys
    config_keys=($(conda config --json --get 2>/dev/null |
        __conda_json_config_keys 2>/dev/null))
    if __conda_is_error_json "${config_keys[@]}"; then
        config_keys=()
    fi
    (( ${#config_keys} )) && print -l -r -- "${config_keys[@]}"
    return 0
}

__conda_describe_existing_config_keys(){
    local -a config_keys
    config_keys=($( __conda_existing_config_keys ))
    if [ "${#config_keys}" -eq 0 ] ; then
        _message "no keys found!"
    else
        _describe -t config_keys 'existing configuration key' config_keys
    fi
}

__conda_describe_existing_list_config_keys(){
    local -a config_keys existing_list_config_keys
    config_keys=($( __conda_existing_config_keys ))
    existing_list_config_keys=()
    for k in "${config_keys[@]}"; do
        if (( ${__conda_list_config_keys[(I)$k]} )) ; then
            existing_list_config_keys+=("$k")
        fi
    done
    if [ "${#existing_list_config_keys}" -eq 0 ] ; then
        _message "no keys found!"
    else
        _describe -t existing_list_config_keys \
            'existing list configuration key' existing_list_config_keys
    fi
}

__conda_existing_config_values(){
    local -a config_values search_term
    search_term="$1"
    config_values=($(conda config --json --get "$search_term" 2>/dev/null |
        __conda_json_config_values "$search_term" 2>/dev/null))
    (( ${#config_values} )) && print -l -r -- "${config_values[@]}"
    return 0
}

__conda_describe_existing_config_values(){
    local -a config_values search_term
    search_term="$1"
    config_values=($( __conda_existing_config_values "$search_term" ))
    if [ "${#config_values}" -eq 0 ] ; then
        _message "no values found for '$search_term'!"
    else
        # compadd keeps values containing colons (e.g. channel urls) intact.
        _wanted config_values expl 'configuration value' \
            compadd -a config_values
    fi
}

__conda_describe_boolean_config_values(){
    local -a config_values
    config_values=(True False)
    _describe -t config_values 'boolean configuration value' config_values
}

__conda_channels(){
    local -a channels
    channels=($( __conda_existing_config_values "channels" ))
    channels+=(system)
    _describe -t channels 'conda channel' channels
}

